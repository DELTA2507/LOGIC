---
import "./AboutCarousel.css"
import { Image } from "astro:assets"
import { machines } from "../../data/machines"

const carouselImages = machines.map((machine) => ({
    image: machine.image,
    alt: machine.alt ?? machine.name,
}))
---

<div class="about-carousel">
    <div class="carousel-track">
        {carouselImages.map((image, index) => (
            <div class="carousel-slide">
                <Image src={image.image} alt={image.alt} />
            </div>
        ))}
    </div>
    <div class="carousel-dots">
        {carouselImages.map((_, index) => (
            <button class:list={["carousel-dot", { active: index === 0 }]} data-index={index} aria-label={`Imagen ${index + 1}`}></button>
        ))}
    </div>
</div>

<script>
    let interval: ReturnType<typeof setInterval> | undefined

    function initAboutCarousel() {
        const track = document.querySelector<HTMLElement>(".about-carousel .carousel-track")
        const dots = document.querySelectorAll<HTMLButtonElement>(".about-carousel .carousel-dot")
        if (!track || dots.length === 0) return

        const total = dots.length
        let current = 0

        function goTo(index: number) {
            current = index
            track!.style.transform = `translateX(-${current * 100}%)`
            dots.forEach((dot, i) => dot.classList.toggle("active", i === current))
        }

        function next() {
            goTo((current + 1) % total)
        }

        // Evita intervalos duplicados al volver a esta página
        clearInterval(interval)
        interval = setInterval(next, 3000)

        dots.forEach((dot, i) => {
            dot.addEventListener("click", () => {
                clearInterval(interval)
                goTo(i)
                interval = setInterval(next, 3000)
            })
        })
    }

    document.addEventListener("astro:page-load", initAboutCarousel)
</script>
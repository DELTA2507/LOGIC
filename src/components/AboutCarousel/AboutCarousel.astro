---
import "./AboutCarousel.css"
import { Image } from "astro:assets"
import iplMachine from "../../assets/machines/ipl-machine.jpg"
import ipl2Machine from "../../assets/machines/ipl2-machine.jpg"
import laserMachine from "../../assets/machines/laser-machine.jpg"
import radiofrecuenciaMachine from "../../assets/machines/radiofrecuencia-machine.png"
import crioterapiaMachine from "../../assets/machines/crioterapia-machine.png"
import ultracavitacionMachine from "../../assets/machines/ultracavitacion-machine.jpg"
import picosecondLampMachine from "../../assets/machines/picosecond-lamp-machine.jpg"

const carouselImages = [
    { image: iplMachine , alt: "Equipo IPL" },
    { image: ipl2Machine, alt: "Equipo IPL 2" },
    { image: laserMachine, alt: "Depilacion Laser" },
    { image: radiofrecuenciaMachine, alt: "Radiofrecuencia" },
    { image: crioterapiaMachine, alt: "Crioterapia" },
    { image: ultracavitacionMachine, alt: "Ultracavitación" },
    { image: picosecondLampMachine, alt: "Lámpara Picosecond" },
]
---

<div class="about-carousel">
    <div class="carousel-track">
        {carouselImages.map((image, index) => (
            <div class="carousel-slide">
                <Image src={image.image} alt={image.alt} />
            </div>
        ))}
    </div>
    <div class="carousel-dots">
        {carouselImages.map((_, index) => (
            <button class:list={["carousel-dot", { active: index === 0 }]} data-index={index} aria-label={`Imagen ${index + 1}`}></button>
        ))}
    </div>
</div>

<script>
    const track = document.querySelector(".carousel-track") as HTMLElement
    const dots = document.querySelectorAll(".carousel-dot")
    const total = dots.length
    let current = 0
    let interval: ReturnType<typeof setInterval>

    function goTo(index: number) {
        current = index
        track.style.transform = `translateX(-${current * 100}%)`
        dots.forEach((dot, i) => dot.classList.toggle("active", i === current))
    }

    function next() {
        goTo((current + 1) % total)
    }

    dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
            clearInterval(interval)
            goTo(i)
            interval = setInterval(next, 3000)
        })
    })

    interval = setInterval(next, 3000)
</script>
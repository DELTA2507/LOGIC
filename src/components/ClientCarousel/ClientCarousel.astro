---
import "./ClientCarousel.css";
import { Image } from "astro:assets";
import client1 from "../../assets/clients/client1.png";
import client2 from "../../assets/clients/client2.jpg";
import client3 from "../../assets/clients/client3.png";
import client4 from "../../assets/clients/client4.jpg";
import client5 from "../../assets/clients/client5.png"

const clients = [
    { logo: client1, alt: "Cliente 1" },
    { logo: client2, alt: "Cliente 2" },
    { logo: client3, alt: "Cliente 3" },
    { logo: client4, alt: "Cliente 4" },
    { logo: client5, alt: "Cliente 5" }
];

const duplicated = [...clients, ...clients];
---

<div class="carousel-container">
    <div class="carousel-track carousel-track-left">
        {
            duplicated.map((client) => (
                <div class="logo-card">
                    <Image src={client.logo} alt={client.alt} loading="lazy" />
                </div>
            ))
        }
    </div>

    <div class="carousel-track carousel-track-right">
        {
            duplicated.map((client) => (
                <div class="logo-card">
                    <Image src={client.logo} alt={client.alt} loading="lazy" />
                </div>
            ))
        }
    </div>
</div>
---
import "../../../styles/home-sections-styles/services-section.css"
import { services } from "../../data/services"
import ServiceCard from "../ServiceCard/ServiceCard.astro"
---

<section class="services">
    <div class="services-header">
        <h2 class="services-title">Nuestros Servicios</h2>
        <p class="services-subtitle">
            Diagnóstico, reparación y mantenimiento profesional de equipamiento médico y estético.
        </p>
    </div>

    <div class="services-list">
        {
            services.map((service) => (
                <ServiceCard {...service} />
            ))
        }
    </div>
</section>
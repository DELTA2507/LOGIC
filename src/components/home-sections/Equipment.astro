---
import "../../../styles/home-sections-styles/equipment.css";

import MachineGallery from "../MachineGallery/MachineGallery.astro";
import CTAButton from "../CTAButton/CTAButton.astro";
---

<section class="equipment" id="equipos">
    <h2>Equipos con los que trabajamos</h2>
    <p>
        Servicio técnico especializado en equipos estéticos profesionales para
        clínicas y centros de estética.
    </p>

    <MachineGallery />

    <div class="equipment-cta">
        <p>¿No ves tu equipo en la lista? Escríbenos y lo revisamos.</p>
        <CTAButton type="whatsapp" />
    </div>
</section>
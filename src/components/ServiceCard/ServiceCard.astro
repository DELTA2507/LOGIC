---
import "./ServiceCard.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    slug: string;
    title: string;
    description: string;
    image: ImageMetadata;
    imagePosition?: string;
    includes: string[];
    notIncluded?: string;
}

const { slug, title, description, image, imagePosition, includes, notIncluded } =
    Astro.props;
---

<a class="service-card" href={`/services#${slug}`}>
    <div class="service-card__media">
        <Image
            src={image}
            alt={title}
            widths={[400, 800]}
            sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 340px"
            loading="lazy"
            style={imagePosition ? `object-position: ${imagePosition}` : undefined}
        />
    </div>

    <div class="service-card__body">
        <h3 class="service-card__title">{title}</h3>
        <p class="service-card__description">{description}</p>

        <ul class="service-card__includes">
            {
                includes.map((item) => (
                    <li>
                        <iconify-icon icon="mdi:check" aria-hidden="true" />
                        <span>{item}</span>
                    </li>
                ))
            }
        </ul>

        {notIncluded && <p class="service-card__limit">{notIncluded}</p>}

        <span class="service-card__link">Ver detalle del servicio</span>
    </div>
</a>
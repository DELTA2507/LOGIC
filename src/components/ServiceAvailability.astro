---
import { Image } from "astro:assets"
import costaRica from "../assets/costa-rica.png"
import "../../styles/home-sections-styles/serviceAvailability.css"
import { weeklySchedule } from "../data/weeklySchedule"
---

<section class="service-availability">
    <hr>

    <div class="schedule-container">
        <div class="schedule-text">
            <h2>Horario Semanal</h2>
            <p>Disponibilidad de servicio los 5 días de la semana.</p>
        </div>

        <ul class="weekly-schedule-container">
            {
                weeklySchedule.map((day) => (
                    <li class="schedule-row">
                        <span class="weekday">{day.weekday}</span>
                        <span class="schedule">{day.schedule}</span>
                    </li>
                ))
            }
        </ul>
    </div>

    <hr>

    <div class="availability-container">
        <Image src={costaRica} alt="Mapa de Costa Rica con sus 7 provincias" />

        <h2 class="availability-title">
            Servicio a domicilio <br><span>dentro y fuera del GAM</span>
        </h2>
    </div>

    <hr>
</section>

<script>
    const daysMap: Record<string, string> = {
        Sunday: "Domingo",
        Monday: "Lunes",
        Tuesday: "Martes",
        Wednesday: "Miércoles",
        Thursday: "Jueves",
        Friday: "Viernes",
        Saturday: "Sábado"
    }

    function markCurrentDay() {
        const currentDay = daysMap[
            new Intl.DateTimeFormat("en-US", {
                timeZone: "America/Costa_Rica",
                weekday: "long"
            }).format(new Date())
        ]

        document.querySelectorAll(".schedule-row").forEach((row) => {
            // Limpia marcas previas para que nunca se duplique el "Hoy"
            row.querySelector(".today-tag")?.remove()
            row.classList.remove("today")
            row.removeAttribute("aria-current")

            const weekday = row.querySelector(".weekday")?.textContent?.trim()

            if (weekday === currentDay) {
                row.classList.add("today")
                // Los lectores de pantalla anuncian "fecha actual"; la etiqueta es solo visual
                row.setAttribute("aria-current", "date")

                const tag = document.createElement("span")
                tag.className = "today-tag"
                tag.setAttribute("aria-hidden", "true")
                tag.textContent = "Hoy"

                row.prepend(tag)
            }
        })
    }

    document.addEventListener("astro:page-load", markCurrentDay)
</script>
---
import "../../styles/header.css"

import { Image } from "astro:assets"
import logo from "../assets/logo.png"
import Navbar from "./Navbar.astro"
import MobileNavbar from "./MobileNavbar/MobileNavbar.astro"
---

<header>
	<a class="logo-link" href="/" aria-label="Ir al inicio">
		<Image
			class="logo"
			src={logo}
			alt="LOGIC Soluciones Técnicas"
			widths={[160, 240]}
			sizes="80px"
			loading="eager"
		/>
	</a>

	<Navbar theme="light" />
	<MobileNavbar />
</header>
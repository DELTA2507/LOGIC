---
import "./CTAButton.css"
import { contact } from "../../data/contact"

interface Props {
    type: "whatsapp" | "email" | "facebook"
}

const { type } = Astro.props

const link = (id: string) => contact.find((item) => item.id === id)!.href

const button_config = {
    whatsapp: {
        href: link("whatsapp"),
        label: "Whatsapp",
        icon: "mdi:whatsapp",
        class_name: "btn-whatsapp"
    },
    email: {
        href: "/contact",
        label: "Correo electrónico",
        icon: "mdi:email",
        class_name: "btn-email"
    },
    facebook: {
        href: link("facebook"),
        label: "Facebook",
        icon: "mdi:facebook",
        class_name: "btn-facebook"
    }
}

const config = button_config[type]
---

<a
    class={`hero-cta-button ${config.class_name}`}
    href={config.href}
    target="_blank"
>
    <iconify-icon
        icon={config.icon}
        noobserver
        style="color: white;"
    ></iconify-icon>

    {config.label}
</a>
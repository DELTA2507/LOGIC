---
import { Image } from "astro:assets";
import "../../styles/page-styles/services.css"
import { services } from "../data/services";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Servicios - LOGIC ST Costa Rica" description="Ofrecemos servicios profesionales de diagnóstico, reparación y mantenimiento de equipo médico y estético.">
	<main class="services">
        <div class="services-hero">
            <h2>Nuestros Servicios</h2>
            <p>Diagnóstico, Reparación y Mantenimiento profesional de equipamiento médico y estético</p>
        </div>

        <div class="services-list">
            {
                services.map((service, index) => {
                    const isReversed = index % 2 !== 0

                    return (
                        <div
                            id={service.slug}
                            class={`service-row ${isReversed ? "reverse" : ""}`}
                        >
                            <div class="service-image">
                                <Image
                                    src={service.image}
                                    alt={service.title}
                                    style={service.imagePosition ? `object-position: ${service.imagePosition}` : undefined}
                                />
                            </div>

                            <div class="service-content">
                                <h3>{service.title}</h3>
                                <p>{service.description}</p>

                                <ul class="service-includes">
                                    {
                                        service.includes.map((item) => (
                                            <li>
                                                <iconify-icon noobserver icon="mdi:check" aria-hidden="true" />
                                                <span>{item}</span>
                                            </li>
                                        ))
                                    }
                                </ul>

                                {service.notIncluded && (
                                    <p class="service-limit">{service.notIncluded}</p>
                                )}
                            </div>
                        </div>
                    )
                })
            }
        </div>
    </main>
</Layout>